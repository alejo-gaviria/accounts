# Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_...

# Stripe Dashboard -> Developers -> Webhooks -> (your endpoint) -> Signing secret
# (or the one printed by `stripe listen` when testing locally)
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase -> Project Settings -> Database -> Connection string -> "Transaction" pooler (port 6543)
# Looks like: postgresql://postgres.xxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres:password@localhost:5432/postgres

# Where the Next.js frontend lives — used to build Stripe's success/cancel
# URLs and to configure CORS. No trailing slash.
FRONTEND_BASE_URL=http://localhost:3000

# Comma-separated extra CORS origins (e.g. a Vercel preview deployment URL).
EXTRA_ALLOWED_ORIGINS=

# Shared secret for the /admin/payments endpoint. Generate something random
# (e.g. `openssl rand -hex 32`) — this is not meant to be memorable, only the
# frontend's server-side code ever sends it. Must match the frontend's
# ADMIN_API_KEY exactly.
ADMIN_API_KEY=
